---
layout: default
title: Projects
permalink: /projects/
description: Open source, side projects, and other things I've shipped to scratch an itch.
---

<%#
  Ranked by stars, not alphabetically. The tiles print the star count, so
  ordering by name handed the reader the ranking data and asked them to sort it
  themselves — a 14-star project sat level with one that has none. Ties fall
  back to the name so the order is stable between builds.
%>
<% projects = collections.projects.resources.sort_by { |p| [-p.data.stars.to_i, p.data.title.to_s.downcase] } %>
<% oss = Array(site.data.oss).sort_by { |r| [-r["stargazerCount"].to_i, r["name"].to_s.downcase] } %>

<%= render PageShell.new do %>
  <%= render Ui::PageHeader.new(title: "Projects", description: data.description) %>

  <% if projects.any? %>
    <%= render PageSection.new(spacing: (oss && oss.any? ? :default : :none)) do %>
      <%= render CardGrid.new do %>
        <% projects.each do |p| %>
          <%= render ProjectCard.new(project: p) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if oss && oss.any? %>
    <%= render PageSection.new(
    spacing: :none,
    label: "From GitHub",
  ) do %>
      <%= render CardGrid.new do %>
        <% oss.each do |repo| %>
          <%= render ProjectCard.new(
            project: {
              name: repo["name"],
              desc: repo["description"],
              status: "active",
              lang: repo["primaryLanguage"] && repo["primaryLanguage"]["name"],
              color: repo["primaryLanguage"] && repo["primaryLanguage"]["color"],
              stars: repo["stargazerCount"],
              href: repo["url"],
            },
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
