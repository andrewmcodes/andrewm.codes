<%#
  The whole public list, straight from GitHub, ordered by most recent push.
  `src/_data/oss.json` is refreshed daily by .github/workflows/sync-oss.yml, so
  this page is never hand-maintained and never goes quietly stale.

  Ordered by recency but deliberately printing no dates: these are peers with
  no meaningful order, and recency is the heuristic that decides which peer to
  show first — not a chronology the reader is meant to read down. Printing the
  date would make it one, and a grid never carries dated content.
%>
<% repos = Array(site.data.oss).sort_by { |r| r["pushedAt"].to_s }.reverse %>

<%= render PageShell.new do %>
  <%= render Stack.new(space: :xxl) do %>
    <%= render Ui::PageHeader.new(
      title: "Projects",
      description: "#{repos.size} public repositories, most recently worked on first.",
    ) %>

    <% if repos.any? %>
      <%= render CardGrid.new do %>
        <% repos.each do |repo| %>
          <%= render ProjectCard.new(
            project: {
              name: repo["name"],
              desc: repo["description"],
              lang: repo["primaryLanguage"] && repo["primaryLanguage"]["name"],
              color: repo["primaryLanguage"] && repo["primaryLanguage"]["color"],
              stars: repo["stargazerCount"],
              forks: repo["forkCount"],
              href: repo["url"],
              status: "active",
            },
          ) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
