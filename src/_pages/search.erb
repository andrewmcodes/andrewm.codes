---
layout: default
title: Search
permalink: /search/
description: "Search andrewm.codes from one place: posts, projects, talks, podcasts, and pages."
noindex: true
sitemap: false
---

<%= render PageShell.new(width: :narrow) do %>
  <%= render Ui::PageHeader.new(title: "Search", description: data.description) %>

  <form data-search-form role="search" class="mb-6">
    <label for="search-input" class="sr-only">Search the site</label>

    <input
      type="search"
      id="search-input"
      name="q"
      autocomplete="off"
      placeholder="Search posts, projects, talks…"
      class="
        w-full bg-mauve-2 border border-mauve-6 rounded-md px-4 py-2.5 text-body text-mauve-12
        placeholder:text-mauve-11 focus:outline-none focus:border-ruby-9 focus:ring-2
        focus:ring-ruby-8
      "
    >
  </form>

  <p
    data-search-status
    class="font-mono text-label text-mauve-11 mb-3"
    aria-live="polite"
  ></p>

  <ul data-search-results class="flex flex-col"></ul>

  <%= render Stack.new(space: :xl, "data-search-suggestions": true) do %>
    <%= render PageSection.new(label: "Explore") do %>
      <%= render TagCloud.new(tags: ["rails", "ruby", "bridgetown"]) %>

      <p class="text-note">
        <a href="/posts/" class="underline">All writing</a> ·
        <a href="/projects/" class="underline">Projects</a> ·
        <a href="/speaking/" class="underline">Speaking</a>
      </p>
    <% end %>

    <%= render PageSection.new(label: "Recent writing") do %>
      <% collections.posts.resources.sort_by(&:date).reverse.first(3).each do |post| %>
        <%= render PostRow.new(post: post) %>
      <% end %>
    <% end %>
  <% end %>

  <noscript>
    <p class="text-mauve-11 text-body">
      Search needs JavaScript. Browse
      <a href="/posts/" class="
        text-ruby-11 border-b border-ruby-11/50 hover:border-ruby-11
        transition-colors
      ">all posts</a>
      instead.
    </p>
  </noscript>
<% end %>
