<nav
  class="
    source-list hidden shell:flex shell:flex-col shell:sticky shell:top-0
    shell:h-svh bg-chrome px-4 py-6 overflow-y-auto
  "
  aria-label="Primary"
  data-pagefind-ignore
>
  <%= render Lockup.new(size: :rail) %>

  <%= render Stack.new(space: :xxs, class: "mt-7") do %>
    <% primary.each do |item| %>
      <%= render SourceLink.new(
        label: item["label"],
        href: item["url"],
        icon: item["icon"],
        current: current?(item["url"]),
      ) %>
    <% end %>
  <% end %>

  <p class="mt-8 mb-2 px-3 m-0 text-label text-mauve-11">elsewhere</p>

  <%= render Stack.new(space: :xxs) do %>
    <% elsewhere.each do |item| %>
      <%= render SourceLink.new(
        label: item["label"],
        href: item["url"],
        icon: item["icon"],
        external: item["url"].to_s.start_with?("http"),
      ) %>
    <% end %>
  <% end %>

  <%#
    Pinned to the foot of the rail. Search and theme are the two controls that
    belong to the application rather than to any view, so they live where an
    application keeps them, not in a footer three screens down.
  %>
  <div class="mt-auto pt-8">
    <%#
      `w-full`, not `flex-1`: a `<button>` sizes to fit-content even at
      `display: flex`, and the `flex-1` it carried was inert on a block parent,
      so the control ended at the "K" of its own shortcut badge. It is a field
      now as well as a row — the thing it opens is a text input, and a trigger
      that looks like a link promises a link.
    %>
    <button
        type="button"
        data-cmdk-trigger
        class="
          group flex w-full min-w-0 items-center gap-2.5 rounded-md border
          border-mauve-6 bg-mauve-2 px-3 py-2 text-nav text-mauve-11
          hover:border-mauve-7 hover:bg-mauve-3 hover:text-mauve-12
          transition-colors focus-visible:outline focus-visible:outline-2
          focus-visible:outline-offset-2 focus-visible:outline-ruby-9
        "
        aria-label="Search"
      >
        <%= render Icon.new(name: "nav_search", class: "shrink-0 text-mauve-10 group-hover:text-mauve-12 transition-colors") %>
        <span>Search</span>
        <kbd
          class="
            ml-auto shrink-0 rounded bg-mauve-3 px-1.5 py-0.5 font-mono text-micro
            text-mauve-11 group-hover:bg-mauve-4
          "
        >⌘K</kbd>
    </button>

    <div class="mt-3 px-1">
      <%= render ThemeToggle.new %>
    </div>
  </div>
</nav>
