<ul class="flex flex-col gap-3.5 m-0 p-0 list-none">
  <li class="grid grid-cols-[92px_1fr] gap-4 max-sm:grid-cols-1 max-sm:gap-0.5">
    <span class="font-mono text-meta text-slate-10 lowercase pt-px">
      building
    </span>

    <span class="text-note leading-snug text-slate-11 text-pretty">
      Shipping Ruby on Rails at
      <%= render Link.new(href: "https://www.podia.com/", variant: :inline) do %>
        Podia
      <% end %>, with a soft spot for CI, tooling, and developer experience.
    </span>
  </li>

  <% if episode_url %>
    <li class="grid grid-cols-[92px_1fr] gap-4 max-sm:grid-cols-1 max-sm:gap-0.5">
      <span class="font-mono text-meta text-slate-10 lowercase pt-px">
        podcasting
      </span>

      <span class="text-note leading-snug text-slate-11 text-pretty">
        Co-hosting
        <%= render Link.new(href: episode_url, variant: :inline) do %>
          Remote Ruby
        <% end %><%= episode_suffix %>
      </span>
    </li>
  <% end %>

  <% if talk_field(:title) %>
    <li class="grid grid-cols-[92px_1fr] gap-4 max-sm:grid-cols-1 max-sm:gap-0.5">
      <span class="font-mono text-meta text-slate-10 lowercase pt-px">
        speaking
      </span>

      <span class="text-note leading-snug text-slate-11 text-pretty">
        Most recently gave
        <%= render Link.new(href: "/speaking/", variant: :inline) do %>
          <%= talk_field(:title) %>
        <% end %><%= talk_suffix %>
      </span>
    </li>
  <% end %>
</ul>
