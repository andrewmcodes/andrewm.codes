<nav aria-label="Related posts" class="mt-10 pt-7 border-t border-slate-5">
  <h2 class="font-mono text-label uppercase text-slate-10 mb-3">
    Related posts
  </h2>

  <ul class="flex flex-col">
    <% posts.each do |post| %>
      <li>
        <a
          href="<%= post.relative_url %>"
          class="
            group flex items-baseline gap-3 py-1.5 font-mono text-note text-slate-11
            hover:text-ruby-11 transition-colors
          "
        >
          <span class="text-slate-9 whitespace-nowrap">
            <%= post.date.strftime("%b %Y") %>
          </span>

          <span
            class="
              font-sans text-note text-slate-12 group-hover:text-ruby-11
              transition-colors
            "
          >
            <%= post.data.title %>
          </span>
        </a>
      </li>
    <% end %>
  </ul>
</nav>
