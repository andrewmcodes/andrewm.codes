<section class="pt-24 pb-10 max-nav:pt-16 max-compact:pt-12">
  <div
    class="
      grid grid-cols-[minmax(0,1fr)_minmax(0,300px)] gap-x-16 gap-y-10 items-start
      max-nav:grid-cols-1 max-nav:gap-y-9
    "
  >
    <div>
      <h1
        class="
          text-display m-0 mb-8 text-balance max-w-[680px] text-slate-12
        "
      >
        Andrew Mason<span class="text-ruby-11">.</span>
      </h1>

      <p
        class="
          text-lede text-slate-11 max-w-[62ch] m-0 mb-4
          text-pretty
        "
      >
        Ruby on Rails engineer at
        <%= render Link.new(href: "https://podia.com", variant: :inline) do %>
          Podia
        <% end %>, co-host of
        <%= render Link.new(href: "/speaking/", variant: :inline) do %>
          Remote Ruby
        <% end %>, and based in Arizona.
      </p>

      <p
        class="
          text-lede text-slate-11 max-w-[62ch] m-0
          text-pretty
        "
      >
        I've been doing the Rails thing for about a decade, from full-stack
        product features to fast CI and developer tooling to the billing and
        data migrations underneath. Most of what I figure out along the way
        ends up written down here.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <%= render Button.new(href: "/posts/", variant: :primary, size: :xl) do %>
          Read the writing
          <%= render Icon.new(
            name: "arrow_right",
            class: "ml-1.5 inline-block transition-transform group-hover:translate-x-0.5",
          ) %>
        <% end %>

        <%= render Button.new(href: "/projects/", variant: :secondary, size: :xl) do %>
          Browse projects
        <% end %>

        <%= render Button.new(href: "https://remoteruby.com/", variant: :ghost, size: :xl) do %>
          Listen to Remote Ruby
        <% end %>
      </div>
    </div>

    <div class="max-nav:max-w-[420px] max-nav:w-full">
      <div
        class="
          font-mono text-xs font-medium uppercase tracking-[0.08em] text-slate-11 pb-2
          border-b border-slate-4
        "
      >
        index
      </div>

      <ul class="list-none m-0 p-0">
        <% index_rows.each do |row| %>
          <li>
            <a
              href="<%= row[:href] %>"
              class="
                group flex items-baseline justify-between gap-4 py-2.5 border-b
                border-slate-4
              "
            >
              <span
                class="
                  text-note text-slate-12 group-hover:text-ruby-11
                  transition-colors
                "
              >
                <%= row[:label] %>
              </span>

              <span
                class="
                  font-mono text-meta text-slate-11 whitespace-nowrap
                  group-hover:text-ruby-11 transition-colors
                "
              >
                <%= row[:value] %>
              </span>
            </a>
          </li>
        <% end %>
      </ul>

      <p class="mt-4 m-0 font-mono text-meta leading-[1.6] text-slate-11">
        mostly so I can find them again later.
      </p>
    </div>
  </div>
</section>
