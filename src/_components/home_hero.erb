<section>
  <img
    src="/images/main-avatar-56.266c347e.webp"
    srcset="/images/main-avatar-28.81a23e39.webp 28w, /images/main-avatar-56.266c347e.webp 56w, /images/main-avatar-112.a70aa686.webp 112w, /images/main-avatar-224.214c61e3.webp 224w"
    sizes="56px"
    alt="Andrew Mason"
    width="112"
    height="112"
    class="w-14 h-14 rounded-full object-cover"
  >

  <h1 class="mt-6 m-0 text-display text-mauve-12">Andrew Mason</h1>

  <%#
    The second-largest object on the page is a sentence in the secondary tone.
    That is the whole reason the name above it reads as the first thing: the
    hierarchy is value and weight, with no rule and no accent field involved.
  %>

  <p class="mt-4 m-0 text-lead text-mauve-11 max-w-[30ch] text-pretty">
    Rails engineer at
    <a href="https://podia.com" class="
      text-mauve-12 underline decoration-mauve-7 underline-offset-[0.22em]
      hover:decoration-ruby-11 transition-colors
    ">Podia</a>,
    co-host of
    <a href="https://remoteruby.com/" class="
      text-mauve-12 underline decoration-mauve-7 underline-offset-[0.22em]
      hover:decoration-ruby-11 transition-colors
    ">Remote Ruby</a>,
    located in Phoenix, AZ. 🌵
  </p>

  <div class="mt-7 flex flex-wrap items-center gap-1 -ml-2">
    <% socials.each do |s| %>
      <a
        href="<%= s[:url] %>"
        <%== 'target="_blank" rel="me noreferrer"' if s[:url].start_with?("http") %>
        aria-label="<%= s[:name] %>"
        title="<%= s[:name] %>"
        class="
          inline-flex h-11 w-11 items-center justify-center rounded-md text-mauve-10
          hover:bg-mauve-3 hover:text-mauve-12 transition-colors
        "
      >
        <%= render Icon.new(name: s[:icon], size: :sm) %>
      </a>
    <% end %>
  </div>

  <p class="mt-3 m-0 text-note text-mauve-11">
    <%= render Link.new(href: "https://bsky.app/profile/andrewm.codes", variant: :inline) do %>
      Invite me to your podcast or conference
    <% end %>.
  </p>

  <%#
    The one place a number appears in the first viewport. A hiring manager
    reading nothing else should still see that the lists below are a decade
    deep — and every figure here is counted from the collections at build time
    rather than typed in, so it cannot go quietly stale.
  %>

  <p
    class="
      mt-6 m-0 flex flex-wrap items-center gap-x-2.5 gap-y-1 font-mono
      text-meta text-mauve-11
    "
  >
    <% ledger.each_with_index do |fact, i| %>
      <% if i > 0 %>
        <span aria-hidden="true" class="text-mauve-9">·</span>
      <% end %>

      <span><%= fact %></span>
    <% end %>
  </p>
</section>
