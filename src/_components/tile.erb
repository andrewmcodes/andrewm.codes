<%= render Link.new(
  href: href,
  external: external?,
  class: "group flex flex-col gap-1 bg-slate-1 hover:bg-slate-2 transition-colors py-3.5 md:p-5"
) do %>
  <div class="flex items-center gap-2.5 mb-1">
    <span class="inline-flex items-center gap-1.5 text-row text-slate-12">
      <%= title %><%= render Icon.new(name: "arrow_top_right", class: "w-3 h-3 text-slate-8 group-hover:text-ruby-11 transition-colors") %>
    </span>

    <% if chip %>
      <span class="<%= chip_classes %>"><%= chip %></span>
    <% end %>
  </div>

  <% if desc %>
    <div class="text-note leading-snug text-slate-11 my-1 mb-4 text-pretty"><%= desc %></div>
  <% end %>

  <% if content.to_s.strip != "" %>
    <div class="mt-auto flex items-center gap-3.5 font-mono text-meta text-slate-10">
      <%= content %>
    </div>
  <% end %>
<% end %>
