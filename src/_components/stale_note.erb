<%#
  A caution has to precede the thing it cautions about, so this stays above the
  article — but it used to say so as a three-line amber panel, the tallest
  object between the headline and the first sentence, which on a phone pushed
  the opening line to 64% down the screen. Same words, one row.
%>

<aside
  role="note"
  class="
    flex items-center gap-2.5 rounded-md border border-amber-6 bg-amber-2
    px-3 py-2 text-meta text-mauve-12
  "
>
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-amber-11 shrink-0"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10" />
    <path d="M12 8v4M12 16h.01" />
  </svg>

  <span class="text-pretty">
    Last updated <time datetime="<%= datetime %>"><%= label %></time> — tools
    and best practices may have moved on.
  </span>
</aside>
