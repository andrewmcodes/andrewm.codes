<%= render Tile.new(
  title: name,
  href: href,
  external: external?,
  desc: desc,
  chip: exceptional_status,
) do %>
  <% if lang %>
    <span class="inline-flex items-center gap-1.5">
      <span
        class="w-2 h-2 rounded-full shrink-0"
        style="background: <%= lang_color %>"
      ></span><%= lang %>
    </span>
  <% end %>

  <% facts.each_with_index do |fact, i| %>
    <% if i > 0 || lang %>
      <span aria-hidden="true">·</span>
    <% end %>

    <span><%= fact %></span>
  <% end %>
<% end %>
