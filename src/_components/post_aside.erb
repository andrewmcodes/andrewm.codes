<aside class="nav:sticky nav:top-24 nav:self-start <%= placement %>">
  <%= render BackLink.new(href: back["path"], label: back["label"]) %>

  <dl
    class="
      m-0 font-mono text-meta text-slate-11 flex flex-col gap-1.5
      max-nav:flex-row max-nav:flex-wrap max-nav:gap-x-3.5
    "
  >
    <div>
      <dt class="sr-only">Published</dt>

      <dd class="m-0">
        <time datetime="<%= date.iso8601 %>"><%= date.strftime("%b %-d, %Y") %></time>
      </dd>
    </div>

    <div>
      <dt class="sr-only">Reading time</dt>
      <dd class="m-0"><%= reading_time %> min read</dd>
    </div>

    <div>
      <dt class="sr-only">Author</dt>

      <dd class="m-0">
        <a
          href="/about/"
          rel="author"
          class="hover:text-ruby-11 transition-colors"
        >
          <%= author_name %>
        </a>
      </dd>
    </div>
  </dl>

  <% if tags.any? %>
    <div class="mt-3.5 flex flex-wrap gap-x-3 gap-y-1">
      <% tags.each do |tag| %>
        <%= render Link.new(href: "/tag/#{tag}/", variant: :post_tag) do %>
          #<%= tag %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if show_toc? %>
    <%#
      Filled at build time by Builders::Inspectors::Toc, which reads the
      real rendered headings rather than guessing from source markdown.
    %>
    <%#
      A ten-section tutorial had no navigation at all below `nav`, which is
      where most of the traffic reads it. One rendering serves both: a
      <details> whose summary only shows on small screens, opened on desktop
      by toc.js so the rail behaves as a rail.
    %>
    <details
      data-toc-wrap
      class="group mt-8 pt-5 border-t border-slate-6"
      hidden
    >
      <%#
        The label recipe here is identical to NOW, FEATURED WORK, INDEX and
        TAGS, none of which are interactive — so the post's only navigation
        control on mobile gave no sign it was a control. The chevron is the
        affordance, and it rotates from the open state rather than from JS.
      %>

      <summary
        class="
          nav:hidden list-none marker:hidden cursor-pointer inline-flex items-center
          gap-2 font-mono text-label uppercase text-slate-11
          hover:text-ruby-11 transition-colors
        "
      >
        <%= render Icon.new(
          name: "chevron_right",
          class: "w-3.5 h-3.5 shrink-0 transition-transform group-open:rotate-90",
        ) %>
        Contents
      </summary>

      <nav data-toc aria-labelledby="toc-label">
        <h2
          id="toc-label"
          class="
            m-0 mb-3 font-mono text-label uppercase text-slate-11
            max-nav:sr-only
          "
        >
          Contents
        </h2>
      </nav>
    </details>
  <% end %>
</aside>
