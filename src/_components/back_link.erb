<a
  href="<%= @href %>"
  class="
    group inline-flex items-center gap-1.5 -ml-2 rounded-md px-2 py-1
    font-mono text-meta text-mauve-11 hover:bg-mauve-3 hover:text-mauve-12
    transition-colors
  "
>
  <svg
    width="12"
    height="12"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    class="transition-transform group-hover:-translate-x-0.5"
  >
    <path d="M14 8H3M7 4l-4 4 4 4" />
  </svg>

  <%= @label %>
</a>
