<div
  id="cmdk"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Search the site"
  class="
    cmdk-overlay fixed inset-0 z-[100] bg-mauve-1/70 backdrop-blur-sm flex items-start
    justify-center pt-[12vh]
  "
>
  <div
    class="
      cmdk-panel w-[min(580px,92vw)] bg-mauve-2 border border-mauve-6
      rounded-lg overflow-hidden
    "
  >
    <div class="flex items-center gap-3 px-[18px] py-3.5 border-b border-mauve-6">
      <svg
        class="text-mauve-11 shrink-0"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>

      <input
        id="cmdk-input"
        type="search"
        autocomplete="off"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-results"
        aria-autocomplete="list"
        aria-label="Search posts, talks, episodes, projects"
        placeholder="Search the site…"
        class="
          min-w-0 flex-1 bg-transparent border-0 outline-none text-row text-mauve-12
          placeholder:text-mauve-11
        "
      />

      <button
        type="button"
        data-cmdk-close
        aria-label="Close search"
        class="
          shrink-0 min-w-11 min-h-11 font-mono text-meta text-mauve-11 rounded
          hover:bg-mauve-3
        "
      >
        <span class="cmdk-keyboard">esc</span><span class="cmdk-touch">Close</span>
      </button>
    </div>

    <div
      id="cmdk-results"
      role="listbox"
      aria-label="Search results"
      class="max-h-[52vh] overflow-y-auto py-2"
    ></div>

    <div
      class="
        cmdk-keyboard flex gap-[18px] px-[18px] py-2.5 border-t border-mauve-6 font-mono text-meta
        text-mauve-11
      "
    >
      <span class="inline-flex items-center gap-1.5">
        <kbd class="
          font-mono text-meta bg-mauve-3 border border-mauve-6 rounded text-mauve-11 px-1.5
          py-px
        ">↑↓</kbd>
        navigate
      </span>

      <span class="inline-flex items-center gap-1.5">
        <kbd class="
          font-mono text-meta bg-mauve-3 border border-mauve-6 rounded text-mauve-11 px-1.5
          py-px
        ">↵</kbd>
        open
      </span>

      <span class="inline-flex items-center gap-1.5">
        <kbd class="
          font-mono text-meta bg-mauve-3 border border-mauve-6 rounded text-mauve-11 px-1.5
          py-px
        ">esc</kbd>
        close
      </span>
    </div>
  </div>
</div>
