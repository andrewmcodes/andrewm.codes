<%= render Entry.new(
  density: :media,
  href: listen_url,
  external: true,
  mark: {
    label: field(:mark),
    hue: hue,
    image: cover_url(48),
    srcset: cover_srcset,
    sizes: "48px",
    dim: !field(:active),
  },
  title: field(:name),
  excerpt: field(:tagline),
  meta: facts,
  trailing: field(:role),
) %>
