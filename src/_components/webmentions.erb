<section class="mt-12 pt-7 border-t border-mauve-6" aria-labelledby="webmentions-heading">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    <span class="font-mono text-meta text-mauve-11">syndicated to</span>

    <% syndication_links.each do |s| %>
      <a
        href="<%= s[:href] %>"
        target="_blank"
        rel="noreferrer"
        class="group inline-flex items-center gap-1 font-mono text-meta text-ruby-11 underline decoration-ruby-11/40 underline-offset-4 hover:decoration-ruby-11 transition-colors"
      >
        <%= s[:label] %>
        <%= render Icon.new(name: "arrow_top_right", class: "w-3 h-3 opacity-70 group-hover:opacity-100 transition-opacity") %>
      </a>
    <% end %>
  </div>

  <div class="mt-5 rounded-lg border border-mauve-6 p-6">
    <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="webmentions-heading" class="font-mono text-label uppercase text-mauve-11">webmentions</h2>

      <% if any_mentions? %>
        <p class="font-mono text-meta text-mauve-11"><%= summary_segments.join(" · ") %></p>
      <% end %>
    </header>

    <% if replies.any? %>
      <ul class="mt-6 space-y-6">
        <% replies.each do |wm| %>
          <% a = author_of(wm) %>

          <li class="flex gap-3">
            <% if a["photo"] %>
              <img
                src="<%= a["photo"] %>"
                alt=""
                width="36"
                height="36"
                loading="lazy"
                class="h-9 w-9 flex-none rounded-full object-cover ring-1 ring-mauve-6"
              >
            <% else %>
              <span
                aria-hidden="true"
                class="flex h-9 w-9 flex-none items-center justify-center rounded-full ring-1 ring-mauve-6 font-mono text-meta text-mauve-11"
              >
                <%= initials(handle_of(wm)) %>
              </span>
            <% end %>

            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <%= render Link.new(
                  href: a["url"] || wm["url"],
                  external: true,
                  class_name: "font-mono text-meta text-mauve-11 hover:text-mauve-12 transition-colors",
                ) do %>
                  <%= handle_of(wm) %>
                <% end %>

                <% if published_on(wm) %>
                  <span class="font-mono text-meta text-mauve-11"><%= published_on(wm) %></span>
                <% end %>
              </div>

              <% if content_text(wm) %>
                <p class="mt-1 text-note text-mauve-12 break-words"><%= content_text(wm) %></p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>
    <% elsif !any_mentions? %>
      <p class="mt-4 text-note text-mauve-11">No responses yet — be the first.</p>
    <% end %>

    <div class="mt-6 pt-5 border-t border-mauve-6">
      <details class="group/wm">
        <summary class="cursor-pointer list-none font-mono text-meta text-mauve-11">
          Written a response?
          <span class="text-ruby-11 underline decoration-ruby-11/50 underline-offset-[0.22em] group-open/wm:decoration-ruby-11 transition-colors">Send a webmention.</span>
        </summary>

        <form
          method="post"
          action="https://webmention.io/andrewm.codes/webmention"
          class="mt-3 flex flex-wrap items-center gap-2"
        >
          <input type="hidden" name="target" value="<%= target %>">
          <label for="wm-source" class="sr-only">The URL of your response</label>
          <input
            id="wm-source"
            name="source"
            type="url"
            required
            placeholder="https://your-site.example/your-response"
            class="min-w-0 flex-1 rounded-md border border-mauve-6 bg-transparent px-3 py-2 text-note text-mauve-12 placeholder:text-mauve-9 focus:border-mauve-8 focus:outline-none"
          >
          <button
            type="submit"
            class="rounded-md border border-mauve-6 px-3 py-2 font-mono text-meta text-mauve-11 hover:border-mauve-8 hover:text-mauve-12 transition-colors"
          >
            Send
          </button>
        </form>
      </details>
    </div>
  </div>
</section>
