<footer class="mt-auto px-6 shell:px-12 pb-10 pt-16" data-pagefind-ignore>
  <div class="mx-auto w-full max-w-pane">
    <%#
      The app's controls live in the source list, so the footer is only the
      colophon: who, where the source is, and which commit built this page.
      Nothing here is navigation, which is why nothing here is a second nav.
    %>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-note text-mauve-11">
      <span>© 2019–<%= Date.today.year %> <%= metadata.author.name %></span>

      <span class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a
          href="/changelog/"
          class="hover:text-mauve-12 transition-colors"
        >Changelog</a>

        <a
          href="https://github.com/<%= metadata.repo %>"
          class="hover:text-mauve-12 transition-colors"
        >Source</a>

        <a href="/feed.xml" class="hover:text-mauve-12 transition-colors">RSS</a>

        <a href="/feed.json" class="hover:text-mauve-12 transition-colors">JSON</a>

        <a
          href="<%= latest_commit_url %>"
          title="Latest commit"
          class="font-mono text-meta hover:text-mauve-12 transition-colors"
        ><%= latest_commit_sha %></a>
      </span>
    </div>
  </div>
</footer>
