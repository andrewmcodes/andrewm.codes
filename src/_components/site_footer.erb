<footer class="border-t border-slate-6 mt-16 pt-10 pb-8" data-pagefind-ignore>
  <div class="max-w-[1080px] mx-auto w-full px-9 max-md:px-4">
    <div
      class="
        flex flex-col gap-4 md:flex-row md:flex-wrap md:justify-between md:items-center
        font-mono text-meta text-slate-11
      "
    >
      <span>© 2019–<%= Date.today.year %> <%= metadata.author.name %></span>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <span class="flex flex-wrap gap-x-3 gap-y-1">
          <% accounts.each_with_index do |a, i| %>
            <% if i > 0 %>
              <span>·</span>
            <% end %>

            <a
              href="<%= a["url"] %>"
              class="
                text-slate-11 border-b border-slate-5 pb-px hover:text-ruby-11
                hover:border-ruby-11 transition-colors
              "
            >
              <%= a["name"] %>
            </a>
          <% end %>

          <span>·</span>

          <a
            href="/feed.xml"
            class="
              text-slate-11 border-b border-slate-5 pb-px hover:text-ruby-11
              hover:border-ruby-11 transition-colors
            "
          >
            RSS
          </a>

          <span>·</span>

          <a
            href="/feed.json"
            class="
              text-slate-11 border-b border-slate-5 pb-px hover:text-ruby-11
              hover:border-ruby-11 transition-colors
            "
          >
            JSON
          </a>
        </span>

        <%= render ThemeToggle.new %>
      </div>
    </div>

    <div
      class="
        mt-4 md:mt-3 flex flex-col gap-2 md:flex-row md:flex-wrap md:justify-between
        md:items-center font-mono text-meta text-slate-11
      "
    >
      <span class="flex flex-wrap gap-x-3 gap-y-1">
        <a
          href="/changelog/"
          class="text-slate-11 hover:text-ruby-11 transition-colors"
        >
          Changelog
        </a>

        <span>·</span>

        <a
          href="/uses/"
          class="text-slate-11 hover:text-ruby-11 transition-colors"
        >
          Uses
        </a>

        <span>·</span>

        <a
          href="https://github.com/<%= metadata.repo %>"
          class="text-slate-11 hover:text-ruby-11 transition-colors"
        >
          Source
        </a>
      </span>

      <a
        href="<%= latest_commit_url %>"
        class="
          text-slate-11 hover:text-ruby-11 transition-colors inline-flex items-center
          gap-1.5
        "
        title="Latest commit"
      >
        <%#
          GitHub's commit mark is filled and the site's icon set is stroked;
          a mono SHA in a footer needs no glyph to say what it is.
        %>
        <span><%= latest_commit_sha %></span>
      </a>
    </div>
  </div>
</footer>
