<%#
  Several destinations (video, slides), so the row stays inert and the
  resources are named links rather than one ambiguous whole-row target.
%>

<%= render Entry.new(
  density: :full,
  lead: date_str,
  lead_sub: field(:duration),
  title: field(:title),
  excerpt: field(:excerpt),
  meta: venue_facts,
  links: links,
) %>
