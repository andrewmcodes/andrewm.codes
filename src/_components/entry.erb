<% row = linked? ? Link.new(href: href, external: external?, class: row_classes, **data) : Box.new(class: row_classes, **data) %>

<%= render row do %>
  <% if mark %>
    <div class="relative w-14 h-14 max-sm:w-16 max-sm:h-16 shrink-0">
      <div
        class="
          absolute inset-0 rounded-[10px] inline-flex items-center justify-center
          font-mono text-lg font-medium tracking-[-0.03em] text-slate-1 max-sm:text-sm
        "
        style="background: oklch(0.62 0.14 <%= mark[:hue] %>);<%= " opacity: 0.7;" if mark[:dim] %>"
      >
        <%= mark[:label] %>
      </div>

      <% if mark[:image] %>
        <img
          src="<%= mark[:image] %>"
          alt=""
          loading="lazy"
          onerror="this.style.display='none'"
          class="absolute inset-0 w-full h-full rounded-[10px] object-cover"
          style="<%= "opacity: 0.7;" if mark[:dim] %>"
        />
      <% end %>
    </div>
  <% else %>
    <div class="font-mono text-meta text-slate-11 whitespace-nowrap">
      <div><%= lead %></div>

      <% if lead_sub %>
        <div class="mt-1 text-slate-10"><%= lead_sub %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <% if kicker %>
      <div class="font-mono text-meta text-ruby-11 mb-2 lowercase">
        <%= kicker %>
      </div>
    <% end %>

    <div
      class="
        text-row text-slate-12 text-balance
        <%= "group-hover:text-ruby-11 transition-colors" if linked? %>
        <%= "inline-flex items-center gap-1.5" if title_icon? %>
      "
    >
      <%= title %>

      <% if title_icon? %>
        <%= render Icon.new(name: icon_name, class: "text-slate-8 group-hover:text-ruby-11 transition-colors shrink-0 inline-block translate-y-px") %>
      <% end %>
    </div>

    <% if excerpt %>
      <p
        class="
          text-note leading-snug text-slate-11 mt-1.5 mb-3 max-w-[68ch]
          text-pretty
        "
      >
        <%= excerpt %>
      </p>
    <% end %>

    <% if tags.any? || meta.any? %>
      <div class="mt-1 flex flex-wrap gap-3 font-mono text-meta text-slate-11">
        <% tags.each do |t| %>
          <span><span class="text-slate-8">#</span><%= t %></span>
        <% end %>

        <% meta.each_with_index do |m, i| %>
          <% if i > 0 || tags.any? %>
            <span aria-hidden="true">·</span>
          <% end %>

          <span><%= m %></span>
        <% end %>
      </div>
    <% end %>

    <% if links.any? %>
      <div class="mt-3 flex flex-wrap gap-3.5">
        <% links.each do |l| %>
          <a
            href="<%= l[:href] %>"
            <%= "target=_blank rel=noreferrer" if l[:external] %>
            class="
              inline-flex items-center gap-1 font-mono text-meta text-slate-11
              border-b border-slate-5 pb-px hover:text-ruby-11 hover:border-ruby-11
              transition-colors
            "
          >
            <%= l[:label] %><%= render Icon.new(name: "arrow_top_right", class: "w-3 h-3") %>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if three_column? %>
    <div
      class="
        font-mono text-meta text-slate-11 whitespace-nowrap max-md:hidden
        inline-flex items-center justify-end
      "
    >
      <% if trailing %>
        <span class="uppercase"><%= trailing %></span>
      <% elsif linked? && !title_icon? %>
        <%= render Icon.new(name: icon_name, class: "text-slate-8 group-hover:text-ruby-11 group-hover:translate-x-0.5 transition-all") %>
      <% end %>
    </div>
  <% end %>
<% end %>
