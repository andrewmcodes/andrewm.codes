<% row = linked? ? Link.new(href: href, external: external?, class: row_classes, **data) : Box.new(class: row_classes, **data) %>

<%= render row do %>
  <div class="flex <%= tokens[:align] %> gap-4">
    <% if media? && mark %>
      <div class="relative <%= tokens[:mark] %> shrink-0">
        <div
          class="
            absolute inset-0 rounded-lg inline-flex items-center justify-center
            font-mono text-note font-semibold tracking-[-0.03em] text-white
          "
          style="background: oklch(0.55 0.15 <%= mark[:hue] %>);<%= " opacity: 0.7;" if mark[:dim] %>"
        >
          <%= mark[:label] %>
        </div>

        <% if mark[:image] %>
          <img
            src="<%= mark[:image] %>"
            alt=""
            loading="lazy"
            onerror="this.style.display='none'"
            class="absolute inset-0 w-full h-full rounded-lg object-cover"
            style="<%= "opacity: 0.7;" if mark[:dim] %>"
          />
        <% end %>
      </div>
    <% end %>

    <div class="min-w-0 flex-1">
      <div class="flex items-baseline gap-4">
        <span class="text-row text-mauve-12 <%= title_classes %>">
          <%= title %><% if title_icon? %><%= render Icon.new(
            name: external? ? "arrow_top_right" : "arrow_right",
            class: "ml-1 inline-block w-3.5 h-3.5 align-baseline text-mauve-9 group-hover:text-ruby-11 transition-colors",
          ) %><% end %>
        </span>

        <% if edge_note %>
          <%#
            The measurement is at the edge and out of the reading order: a list
            of titles is scanned down the left, and a date fronting every row
            is the thing that made the archive read as one undifferentiated
            block. It is still here, still tabular, just no longer first.
          %>
          <span class="ml-auto shrink-0 font-mono text-meta text-mauve-11 whitespace-nowrap max-compact:hidden">
            <%= edge_note %>
          </span>
        <% end %>
      </div>

      <% if excerpt %>
        <p class="mt-1.5 m-0 text-note text-mauve-11 max-w-[62ch] text-pretty line-clamp-2">
          <%= excerpt %>
        </p>
      <% end %>

      <% if tags.any? || stacked_facts.any? %>
        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-meta text-mauve-11">
          <% tags.each do |t| %>
            <span><span class="text-mauve-9">#</span><%= t %></span>
          <% end %>

          <% stacked_facts.each_with_index do |m, i| %>
            <% if i > 0 || tags.any? %>
              <span aria-hidden="true" class="text-mauve-9">·</span>
            <% end %>

            <span><%= m %></span>
          <% end %>
        </div>
      <% end %>

      <% if links.any? %>
        <div class="mt-3 flex flex-wrap gap-4">
          <% links.each do |l| %>
            <a
              href="<%= l[:href] %>"
              <%= "target=_blank rel=noreferrer" if l[:external] %>
              class="
                inline-flex items-center gap-1 font-mono text-meta text-mauve-11
                underline decoration-mauve-7 underline-offset-4
                hover:text-ruby-11 hover:decoration-ruby-11 transition-colors
              "
            >
              <%= l[:label] %><%= render Icon.new(name: "arrow_top_right", class: "w-3 h-3") %>
            </a>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
