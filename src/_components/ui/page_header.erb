<div>
  <h1 class="m-0 text-page-title text-mauve-12"><%= title %></h1>

  <% if rich_description? || description || description_html %>
    <p class="mt-3 m-0 text-note text-mauve-11 max-w-[64ch] text-pretty">
      <% if rich_description? %>
        <%= rich_description %>
      <% elsif description_html %>
        <%== description_html %>
      <% else %>
        <%= description %>
        <% if description_link? %>
          <%= render Link.new(href: description_link_href, variant: :inline_accent) do %><%= description_link_label %><% end %>.
        <% end %>
      <% end %>
    </p>
  <% end %>
</div>
