<div class="mb-10">
  <h1 class="text-page-title m-0 mb-3 text-slate-12">
    <%= title %>
  </h1>

  <% if rich_description? || description || description_html %>
    <p class="text-slate-11 max-w-[600px] text-body text-pretty leading-[1.6]">
      <% if rich_description? %>
        <%= rich_description %>
      <% elsif description_html %>
        <%== description_html %>
      <% else %>
        <%= description %>
        <% if description_link? %>
          <%= render Link.new(href: description_link_href, variant: :inline_accent) {
            description_link_label
          } %> .
        <% end %>
      <% end %>
    </p>
  <% end %>
</div>
