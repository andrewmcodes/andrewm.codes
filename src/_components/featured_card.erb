<%= render Link.new(
  href: field(:href),
  external: true,
  class: "group flex flex-col gap-1 bg-slate-1 hover:bg-slate-2 transition-colors py-3.5 md:p-5"
) do %>
  <div class="flex items-center gap-2.5 mb-1">
    <span
      class="
        inline-flex items-center gap-1.5 font-semibold text-body tracking-tight
        text-slate-12
      "
    >
      <%= field(:title) %>

      <%= render Icon.new(
        name: "arrow_top_right",
        class: "w-3 h-3 text-slate-8 group-hover:text-ruby-11 transition-colors",
      ) %>
    </span>

    <% if field(:kind) %>
      <span
        class="ml-auto font-mono text-micro uppercase text-slate-10"
      >
        <%= field(:kind) %>
      </span>
    <% end %>
  </div>

  <div class="text-note leading-snug text-slate-11 my-1 mb-4 text-pretty">
    <%= field(:desc) %>
  </div>

  <% if field(:label) %>
    <div class="mt-auto font-mono text-meta text-slate-10">
      <%= field(:label) %>
    </div>
  <% end %>
<% end %>
