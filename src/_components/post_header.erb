<%#
  Date, reading time, byline, and tags live in PostAside now: they are facts
  about the post, not part of it. This is the title and the actions on it.
%>

<h1 class="text-headline m-0 mb-5 text-balance text-slate-12">
  <%= title %>
</h1>

<div class="mb-10">
  <%= render MarkdownActions.new(resource: resource) %>
</div>
