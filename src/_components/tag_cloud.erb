<%#
  The most-used tags, as one wrapped row. The label used to hang in a 168px
  margin beside them; with no rules anywhere on the page that margin read as a
  misalignment rather than as a rail, so the label now sits directly above the
  tags like every other label on the site.
%>

<% if tags.any? %>
  <div>
    <p class="m-0 mb-2.5 text-label text-mauve-11">tags</p>

    <div class="flex flex-wrap gap-x-3 gap-y-1.5">
      <% tags.each do |tag| %>
        <%= render Link.new(href: "/tag/#{tag}/", variant: :tag) do %>
          #<%= tag %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
