<section class="<%= section_classes %>">
  <% if labelled? %>
    <div class="max-nav:mb-5">
      <h2 class="m-0 font-mono text-label uppercase text-slate-11">
        <%= label %>
      </h2>

      <% if description %>
        <p class="mt-2.5 text-note leading-snug text-slate-11 text-pretty">
          <%= description %>
        </p>
      <% end %>

      <% if link? %>
        <%= render Link.new(href: link_href, variant: :section_action, class: "mt-3.5") do %>
          <%= link_label %><%= render Icon.new(name: icon_name, class: "transition-transform group-hover:translate-x-0.5") %>
        <% end %>
      <% end %>
    </div>

    <div><%= content %></div>
  <% else %>
    <%= content %>
  <% end %>
</section>
