---
title: Text
---

<div class="space-y-6">
  <div class="space-y-2">
    <p class="font-mono text-xs text-mauve-10">Sizes</p>

    <%= render Text.new(size: :meta) do %>
      Small (sm)
    <% end %>

    <%= render Text.new(size: :note) do %>
      Medium (md)
    <% end %>

    <%= render Text.new(size: :body) do %>
      Large (lg)
    <% end %>

    <%= render Text.new(size: :row) do %>
      Extra large (xl)
    <% end %>
  </div>

  <div class="space-y-2">
    <p class="font-mono text-xs text-mauve-10">Weights</p>

    <%= render Text.new(weight: :default) do %>
      Normal weight
    <% end %>

    <%= render Text.new(weight: :medium) do %>
      Medium weight
    <% end %>

    <%= render Text.new(weight: :semibold) do %>
      Semibold weight
    <% end %>

    <%= render Text.new(weight: :bold) do %>
      Bold weight
    <% end %>
  </div>

  <div class="space-y-2">
    <p class="font-mono text-xs text-mauve-10">Schemes</p>

    <%= render Text.new(tone: :neutral) do %>
      Strong
    <% end %>

    <%= render Text.new(tone: :secondary) do %>
      Muted
    <% end %>

    <%= render Text.new(tone: :accent) do %>
      Primary
    <% end %>
  </div>
</div>
