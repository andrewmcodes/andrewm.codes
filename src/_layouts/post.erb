---
layout: default
---

<% collection_label = resource.collection&.label || "posts" %>
<% siblings = collections.send(collection_label).resources.sort_by(&:date).reverse %>
<% idx = siblings.find_index { |p| p.relative_url == resource.relative_url } %>
<% prev_post = idx && siblings[idx + 1] %>
<% next_post = idx && idx > 0 ? siblings[idx - 1] : nil %>
<% back = data.back || { "path" => "/posts/", "label" => "all posts" } %>
<% updated_time = resource.updated_at %>

<%#
  Two rows on desktop so the rail can span them while the reading column is
  split; one column on mobile, where `order` puts the title first.

  The split exists for the mobile order. With the aside as a single grid item
  before the content, everything about the post — date, reading time, tags, the
  contents disclosure — stacked above the post's own name, so a reader who had
  just tapped a headline met the apparatus before the thing they opened.
%>

<%= render PageShell.new(width: :reading) do %>
  <div class="grid items-start nav:grid-cols-[208px_minmax(0,1fr)] nav:gap-x-14">
    <%= render PostAside.new(
      resource: resource,
      back: back,
      show_toc: should_show_toc(resource),
      class: "nav:col-start-1 nav:row-start-1 nav:row-span-2 max-nav:order-2 max-nav:mb-9",
    ) %>

    <div class="nav:col-start-2 nav:row-start-1 max-nav:order-1 min-w-0">
      <%= render PostHeader.new(resource: resource) %>
    </div>

    <div class="nav:col-start-2 nav:row-start-2 max-nav:order-3 min-w-0">
      <% if resource.stale? %>
        <%= render StaleNote.new(updated_at: updated_time) %>
      <% end %>

      <%= render Prose.new(as: :article, variant: :post, max_w: false) do %>
        <%= yield %>
      <% end %>

      <%= render PostFooter.new(
        resource: resource,
        previous_resource: prev_post,
        next_resource: next_post,
      ) %>

      <%= render Webmentions.new(url: resource.relative_url) %>
    </div>
  </div>
<% end %>
