<!doctype html>

<html lang="<%= site.metadata.lang %>">
  <head>
    <script>
      (() => {
        const saved = localStorage.getItem("theme")
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches
        const theme = saved === "light" || saved === "dark" ? saved : (prefersDark ? "dark" : "light")
        document.documentElement.dataset.theme = theme
      })()
    </script>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">

    <%#
      Tells Turbo to wrap its body swap in a same-document view transition.
      The CSS @view-transition rule separately covers browser-managed visits.
    %>
    <meta name="view-transition" content="same-origin">

    <meta
      name="theme-color"
      content="<%= site.metadata.theme_color_light %>"
      media="(prefers-color-scheme: light)"
    >

    <meta
      name="theme-color"
      content="<%= site.metadata.theme_color %>"
      media="(prefers-color-scheme: dark)"
    >

    <%#
      noindex pages still get `follow`: a thin tag page or the 404 is worth
      crawling through to the posts it links, just not worth indexing itself.
      Indexable pages opt into full-length snippets and large image previews.
    %>

    <% if data.noindex %>
      <meta name="robots" content="noindex,follow">
    <% else %>
      <meta
        name="robots"
        content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
      >
    <% end %>

    <%= render Util::Seo.new(resource: resource) %>
    <%= render Util::StructuredData.new(resource: resource) %>

    <% if (markdown_path = markdown_source_path(resource)) %>
      <link rel="alternate" type="text/markdown" href="<%= markdown_path %>">
    <% end %>

    <link
      rel="alternate"
      type="application/atom+xml"
      title="<%= site.metadata.title %> (Atom)"
      href="<%= absolute_url("/feed.xml") %>"
    >

    <link
      rel="alternate"
      type="application/feed+json"
      title="<%= site.metadata.title %> (JSON Feed)"
      href="<%= absolute_url("/feed.json") %>"
    >

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="<%= absolute_url("/sitemap.xml") %>"
    >

    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/images/favicon-32x32.png"
    >

    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/images/favicon-16x16.png"
    >

    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/apple-touch-icon.png"
    >

    <link rel="manifest" href="/site.webmanifest">

    <link
      rel="webmention"
      href="https://webmention.io/andrewm.codes/webmention"
    >

    <link rel="pingback" href="https://webmention.io/andrewm.codes/xmlrpc">

    <link rel="me" href="https://bsky.app/profile/andrewm.codes">
    <link rel="me" href="https://github.com/andrewmcodes">
    <link rel="me" href="https://www.linkedin.com/in/andrewmcodes/">
    <link rel="me" href="https://x.com/andrewmcodes">

    <link rel="stylesheet" href="<%= asset_path :css %>">

    <link
      rel="stylesheet"
      href="<%= Bridgetown.env.production? ? asset_path("styles/tailwind.css") : "/_bridgetown/static/tailwind.css" %>"
    >

    <script type="module" src="<%= asset_path :js %>"></script>
  </head>

  <body class="bg-chrome text-mauve-12 font-sans text-body min-h-screen">
    <% if markdown_path %>
      <div class="sr-only" aria-hidden="true">
        A Markdown version of this page is available at
        <%= absolute_url(markdown_path) %>.
      </div>
    <% end %>

    <%= render SkipLink.new %>

    <%= render AppShell.new(resource: resource, kind: data.kind) do %>
      <%= yield %>
    <% end %>

    <%= render Cmdk.new %>
  </body>
</html>
