---
layout: default
title: andrewm.codes
---

<%#
  A selection, not a feed — see src/_data/selected_posts.yml. Order comes from
  the data file rather than from the dates, and a slug that no longer resolves
  drops out instead of raising.
%>
<% all_posts = collections.posts.resources %>
<% by_slug = all_posts.to_h { |p| [p.relative_url.to_s.split("/").reject(&:empty?).last, p] } %>
<% selected_posts = Array(site.data.selected_posts).filter_map { |slug| by_slug[slug.to_s] } %>
<% post_years = all_posts.map { |p| p.date.year }.minmax %>
<% projects = collections.projects.resources.first(4) %>
<% latest_talk = site.data.talks.max_by { |t| t["date"] || t[:date] } %>
<% latest_episode = site.data.remote_ruby %>

<%= render PageShell.new(spacing: :home) do %>
  <%= render HomeHero.new(
    posts_count: collections.posts.resources.size,
    projects_count: collections.projects.resources.size,
    talks_count: site.data.talks.size,
  ) %>

  <%= render PageSection.new(
    spacing: :home_coda,
    label: "now",
    description: "What I'm actually working on right now.",
  ) do %>
    <%= render HomeNow.new(episode: latest_episode, talk: latest_talk) %>
  <% end %>

  <% if site.data.featured&.any? %>
    <%= render PageSection.new(
      spacing: :home,
      label: "featured work",
      description: "A few things I'm proud of and point people to most often.",
    ) do %>
      <%= render CardGrid.new do %>
        <% site.data.featured.each do |item| %>
          <%= render FeaturedCard.new(item: item) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <%= render PageSection.new(
    spacing: :home,
    label: "writing",
    description: "#{all_posts.size} posts, #{post_years.first}–#{post_years.last}. These five go deepest.",
    link_label: "all posts",
    link_href: "/posts/",
  ) do %>
    <%= render Stack.new do %>
      <% selected_posts.each do |post| %>
        <%= render PostRow.new(post: post, show_reading: false, lead_date: false) %>
      <% end %>
    <% end %>
  <% end %>

  <% if projects.any? %>
    <%= render PageSection.new(
      spacing: :home,
      label: "open source",
      link_label: "all projects",
      link_href: "/projects/",
    ) do %>
      <%= render CardGrid.new do %>
        <% projects.each do |proj| %>
          <%= render ProjectCard.new(project: proj) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if latest_talk || latest_episode %>
    <%= render PageSection.new(
      spacing: :home,
      label: "latest",
      link_label: "talks and podcasts",
      link_href: "/speaking/",
    ) do %>
      <% if latest_talk %>
        <%= render TalkCard.new(talk: latest_talk) %>
      <% end %>

      <% if latest_episode %>
        <%= render EpisodeCard.new(episode: latest_episode) %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
